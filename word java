import java.util.Scanner;

public class words{

    public static int noofwords(String s){

    int count=0;
    for(int i=0;i<s.length();i++){
        if(s.charAt(i)==' '){
            count++;
        }
    }
    return count + 1;

    }

    public static void main(String [ ] args){
        Scanner sc=new Scanner(System.in);
        String s="how are u";
        System.out.println(noofwords(s));





    }
}
